# URL pública do site. Usada em canonical, Open Graph e sitemap.
# Sem isto, tudo aponta para o placeholder definido em src/data/site.ts.
NEXT_PUBLIC_SITE_URL=https://workupfit.com.br

# Destino dos leads dos formulários (POST JSON com o tipo `Lead` de
# src/lib/leads.ts). Enquanto estiver vazio os formulários NÃO enviam nada e
# avisam o visitante disso — nunca fingem sucesso.
NEXT_PUBLIC_LEADS_ENDPOINT=

# Registro público de certificados, consultado por /validar-certificado/[id].
# Vazio => a página responde "validação ainda não está ativa" (e não
# "certificado não encontrado", que acusaria falsidade sem ter checado).
CERTIFICATE_REGISTRY_ENDPOINT=
